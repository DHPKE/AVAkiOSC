[Unit]
Description=AVAkiOSC OSC/UDP Text Controller + Chromium Launcher
After=network.target

[Service]
User=kiosk
Group=kiosk
Environment=PATH=/opt/avakiosc/venv/bin:/usr/bin:/bin
WorkingDirectory=/opt/avakiosc/app
ExecStart=/opt/avakiosc/venv/bin/python /opt/avakiosc/app/avakiosc.py
Restart=always
RestartSec=2
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target