[Unit]
Description=AVAkiOSC OSC/UDP Text Controller + Chromium Launcher
After=network.target getty@tty1.service

[Service]
User=kiosk
Group=kiosk
Environment=PATH=/opt/avakiosc/venv/bin:/usr/bin:/bin
Environment=DISPLAY=:0
WorkingDirectory=/opt/avakiosc/app
# Chromium needs the kiosk X session (started via autologin+xinit) to be up first.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /tmp/.X11-unix/X0 ] && exit 0; sleep 1; done'
ExecStart=/bin/sh -c 'export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$(id -u)/bus; exec /opt/avakiosc/venv/bin/python /opt/avakiosc/app/avakiosc.py'
Restart=always
RestartSec=2
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target