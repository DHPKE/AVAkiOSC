[Unit]
Description=AVAkiOSC WebAdmin
After=network.target

[Service]
User=kiosk
Group=kiosk
Environment=PATH=/opt/avakiosc/venv/bin:/usr/bin:/bin
WorkingDirectory=/opt/avakiosc/app
ExecStart=/opt/avakiosc/venv/bin/python /opt/avakiosc/app/webadmin.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target